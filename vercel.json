{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": null,
    "installCommand": "npm ci --ignore-scripts",
    "buildCommand": "npm run build",
    "outputDirectory": "public",
    "regions": ["sin1"],
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0",
            "maxDuration": 30,
            "excludeFiles": "{node_modules/**,tests/**,docs/**,artifacts/**,.agents/**,.claude/**,.git/**,.vercel/**,storage/framework/tmp/**,storage/app/visual-qa/**,.env,.env.*}"
        }
    },
    "routes": [
        { "src": "/index\\.php", "dest": "/api/index.php" },
        { "handle": "filesystem" },
        { "src": "/(.*)", "dest": "/api/index.php" }
    ],
    "env": {
        "APP_NAME": "ALJON DE JESUS Portfolio",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://aljon-dejesus.vercel.app",
        "LOG_CHANNEL": "stderr",
        "SESSION_DRIVER": "database",
        "SESSION_SECURE_COOKIE": "true",
        "CACHE_STORE": "database",
        "QUEUE_CONNECTION": "sync"
    }
}
